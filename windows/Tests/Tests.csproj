<Project Sdk="Microsoft.NET.Sdk">
  <!-- 逻辑测试：只测不碰系统的部分（认卡片、算翻页、比标题、记录文件），Mac 上也能跑；用法：dotnet run -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WXLinks.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../WXLinks/Engine/Core.cs" Link="Core.cs" />
    <Compile Include="../WXLinks/Engine/Shapes.cs" Link="Shapes.cs" />
    <Compile Include="../WXLinks/Engine/Vision.cs" Link="Vision.cs" />
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
